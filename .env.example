# Copy to .env (gitignored) or set the variable in your shell:
#   PowerShell (persistent):  setx MAGNIFIC_API_KEY "your-key"
#   PowerShell (session):     $env:MAGNIFIC_API_KEY = "your-key"
MAGNIFIC_API_KEY=
# Optional: default quality for generation runs (low | medium | high)
MAGNIFIC_DEFAULT_QUALITY=high
